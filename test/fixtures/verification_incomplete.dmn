<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             id="incomplete_definitions"
             name="Incomplete surcharge"
             namespace="https://ash-decisions.test/incomplete"
             expressionLanguage="https://www.omg.org/spec/DMN/20230324/FEEL/"
             typeLanguage="https://www.omg.org/spec/DMN/20230324/FEEL/">
  <inputData id="input_order_total" name="orderTotal">
    <variable id="var_order_total" name="orderTotal" typeRef="number"/>
  </inputData>
  <decision id="decision_surcharge" name="Surcharge">
    <variable id="var_surcharge" name="Surcharge" typeRef="number"/>
    <informationRequirement id="req_total">
      <requiredInput href="#input_order_total"/>
    </informationRequirement>
    <decisionTable id="table_surcharge" hitPolicy="UNIQUE" outputLabel="Surcharge">
      <input id="clause_total" label="Order total">
        <inputExpression id="expr_total" typeRef="number">
          <text>orderTotal</text>
        </inputExpression>
      </input>
      <output id="clause_surcharge" name="surcharge" label="Surcharge" typeRef="number"/>
      <rule id="rule_large">
        <inputEntry id="rule_large_0"><text>&gt;= 1000</text></inputEntry>
        <outputEntry id="rule_large_1"><text>50</text></outputEntry>
      </rule>
      <rule id="rule_tiny">
        <inputEntry id="rule_tiny_0"><text>&lt; 500</text></inputEntry>
        <outputEntry id="rule_tiny_1"><text>5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
