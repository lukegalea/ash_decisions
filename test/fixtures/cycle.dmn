<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             id="cycle_definitions"
             name="Cycle"
             namespace="https://ash-decisions.test/cycle"
             expressionLanguage="https://www.omg.org/spec/DMN/20230324/FEEL/"
             typeLanguage="https://www.omg.org/spec/DMN/20230324/FEEL/">
  <decision id="decision_a" name="A">
    <variable id="var_a" name="A" typeRef="number"/>
    <informationRequirement id="req_a_b">
      <requiredDecision href="#decision_b"/>
    </informationRequirement>
    <literalExpression id="expr_a" typeRef="number"><text>B + 1</text></literalExpression>
  </decision>
  <decision id="decision_b" name="B">
    <variable id="var_b" name="B" typeRef="number"/>
    <informationRequirement id="req_b_a">
      <requiredDecision href="#decision_a"/>
    </informationRequirement>
    <literalExpression id="expr_b" typeRef="number"><text>A + 1</text></literalExpression>
  </decision>
</definitions>
